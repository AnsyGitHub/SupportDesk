# Configuration examples for both hosts: Ticket storage and explicitly selected AI.
# .NET reads environment variables; it does not load this file automatically.
# Both hosts must use the same absolute database path.
ConnectionStrings__SupportDesk="Data Source=/absolute/path/to/supportdesk.db"
# Mock returns labeled synthetic suggestions without contacting a provider.
AI__Provider=Mock
# To contact Gemini, set AI__Provider=Gemini and supply these outside source control:
AI__Model=gemini-3.5-flash-lite
AI__ApiKey=your-api-key
# Optional deadline in seconds (default 30; accepted range 1-300).
AI__TimeoutSeconds=60
# Optional for Gemini 3.x models: e.g. low for 3.8 Flash. Blank uses the model default.
AI__ThinkingLevel=
